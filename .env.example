# --- App ---
DATABASE_URL=postgresql://postgres:postgres@db:5432/oddly
JWT_SECRET=super-secret-change-me-in-production
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0

# --- S3 ---
S3_ENDPOINT_URL=https://s3.amazonaws.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=oddly-offers
S3_REGION=us-east-1
S3_PUBLIC_URL=https://oddly-offers.s3.amazonaws.com

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@oddly.com

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
FRONTEND_URL=http://localhost:3000

# --- Docker Compose (infra) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
